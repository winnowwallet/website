#!/usr/bin/env python3
"""Generate the homepage and the focused app journey recording page.

The journey media come from one of two places. When docs/journey-provenance.json is a version 2 manifest
(the wallet CI's journey-media artifact, placed by scripts/fetch-journey-media), the gallery, hero, sizes and
recording provenance come from it: its screenshots in order, captioned from docs/journeys.json. Otherwise
the pages describe the committed reference media, validated against the pinned Swift UI tests in upstream/.
"""
import argparse
import hashlib
import html
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TEST_PATH = "UITests/WinnowAppUITests.swift"
SOURCE = "https://github.com/winnowwallet/winnow/blob/7751cfd30f5e1b108fcfe322db38b76948a0bb1d/"
VIDEO_PATH = "videos/wallet-journey.mp4"
# The recorded journey's checkpoints, in the order the run tells its story.
# load_journeys refuses any name here that the UI journey does not capture, so
# the homepage cannot show a screen no test produced.
ACTS = [
    ("An ordinary payment", [
        ("01-onboarding", "Create a wallet"),
        ("03-receive", "Show a receive address"),
        ("56-home-beginner", "The coins arrive"),
        ("06-send-review", "Check address, fee, total"),
        ("08-send-confirmed", "Confirmed on Bitcoin"),
        ("09-home-after-send", "History keeps the receipt"),
    ]),
    ("Two keys, both sign", [
        ("35-extra-device-policy", "Both keys required"),
        ("36-extra-device-review", "Review the payment"),
        ("37-extra-device-waiting", "Waiting for the second key"),
        ("39-extra-device-sent", "Both signed, sent"),
        ("40-extra-device-confirmed", "Confirmed"),
    ]),
    ("Two of three", [
        ("26-savings-share", "Share with the other signers"),
        ("27-savings-funded", "The account is funded"),
        ("14-approval-waiting", "One signature so far"),
        ("15-approval-sent", "Two sign, it sends"),
        ("28-savings-confirmed", "Confirmed"),
    ]),
]
SHOT_WIDTH, SHOT_HEIGHT = 1206, 2622
MANIFEST = "docs/journey-provenance.json"
# The repository whose CI makes a version 2 manifest: the Lean app's. A manifest without a run URL links its commit here.
WALLET = "https://github.com/winnowwallet/winnow-lean"
# Gallery headings for the CI journeys' tests; a test not named here gets its name in words.
TEST_HEADINGS = {
    "testCreateReceiveSendConfirm": "An ordinary payment",
    "testLedgerPairVerifySpend": "A Ledger as the second key",
    "testLedgerCardTwoOfTwo": "A Ledger nearby, set up from its card",
    "testMultisigTwoOfThreeWithRecovery": "Two of three, and the recovery path",
    "testFeeBumpReplaceConfirm": "A pending payment replaced at a higher fee",
    "testRetryAfterNoPeers": "Offline, then Retry",
    "testShippedCensus": "Settings: the peer census, backup and multisig accounts",
    "testSilentPaymentSend": "A silent payment",
    "testSpentElsewhere": "Coins spent from another device",
    "testCardForOnePerson": "A card for one person",
}
# The hero's three modes with CI media: the first of each mode's screenshots the manifest has. Without one,
# that mode keeps its committed reference screenshot and words.
CI_MODES = {
    "everyday": (["07-home-after-send", "04-home-funded"], {}),
    "both": (["22-ledger-confirmed", "21-ledger-signed"], {
        "caption": "Your phone and a Ledger", "heading": "Two keys. Both sign.",
        "description": "Your phone and a Ledger both approve each payment.",
        "technical": "2-of-2 · 2 signatures"}),
    "shared": (["13-multisig-sent", "11-multisig-funded"], {}),
}


def unresolved(path):
    with path.open("rb") as media:
        return media.read(128).startswith(b"version https://git-lfs.github.com/spec/v1")


def sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as media:
        for block in iter(lambda: media.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def positive(value):
    return type(value) in (int, float) and value > 0


def load_manifest(root):
    """The version 2 CI manifest, validated against the files it names; None for the reference media."""
    path = root / MANIFEST
    if not path.is_file():
        return None
    evidence = json.loads(path.read_text())
    if not isinstance(evidence, dict) or evidence.get("version") != 2:
        return None
    if not re.fullmatch(r"[0-9a-f]{40}", str(evidence.get("source_sha"))):
        raise ValueError("journey manifest: invalid source commit")
    run_url = evidence.get("run_url")
    if run_url is not None and not re.fullmatch(r"https://\S+/actions/runs/\d+(/attempts/\d+)?", str(run_url)):
        raise ValueError("journey manifest: invalid run URL")
    tests = evidence.get("tests")
    if evidence.get("result") != "passed" or not isinstance(tests, list) or not tests:
        raise ValueError("journey manifest: the journey did not pass")
    names = [test.get("name") for test in tests]
    if len(set(names)) != len(names) or not all(isinstance(name, str) and name for name in names):
        raise ValueError("journey manifest: invalid or duplicate test names")
    if failed := [test["name"] for test in tests if test.get("result") != "passed" or not positive(test.get("seconds"))]:
        raise ValueError("journey manifest: test did not pass: " + ", ".join(failed))
    shots = evidence.get("screenshots")
    if not isinstance(shots, list) or not shots:
        raise ValueError("journey manifest: no screenshots")
    seen = set()
    files = {}
    for shot in shots:
        name = shot.get("name")
        if not isinstance(name, str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name) or name in seen:
            raise ValueError(f"journey manifest: invalid or duplicate screenshot {name!r}")
        seen.add(name)
        if shot.get("test") is not None and shot["test"] not in names:
            raise ValueError(f"journey manifest: {name} names a test the run does not list")
        if type(shot.get("width")) is not int or type(shot.get("height")) is not int or min(shot["width"], shot["height"]) <= 0:
            raise ValueError(f"journey manifest: {name} has no size")
        files[f"screenshots/{name}.png"] = shot
    video = evidence.get("video")
    if not isinstance(video, dict) or video.get("path", VIDEO_PATH) != VIDEO_PATH:
        raise ValueError("journey manifest: no video at " + VIDEO_PATH)
    if not all(positive(video.get(key)) for key in ("width", "height", "duration_seconds", "bytes")):
        raise ValueError("journey manifest: the video has no size or duration")
    files[VIDEO_PATH] = video
    for relative, entry in files.items():
        media = root / "docs" / relative
        if not media.is_file():
            raise ValueError(f"journey manifest: missing {relative}")
        if unresolved(media):
            raise ValueError(f"journey manifest: {relative} is an unresolved LFS pointer")
        if media.stat().st_size != entry.get("bytes", media.stat().st_size) or sha256(media) != entry.get("sha256"):
            raise ValueError(f"journey manifest: {relative} does not match its SHA-256 or byte count")
    return evidence


def check_inventory(root, journeys):
    """The checks every build makes of docs/journeys.json, with or without the pinned UI tests."""
    seen, ids, captions = set(), set(), {}
    for journey in journeys:
        identity = journey["id"]
        if not re.fullmatch(r"[a-z][a-z0-9-]*", identity) or identity in ids:
            raise ValueError(f"duplicate or invalid journey id: {identity}")
        ids.add(identity)
        if journey["section"] not in {"everyday", "advanced"}:
            raise ValueError(f"{identity}: choose an everyday or advanced section")
        if guide := journey.get("guide"):
            if not guide.startswith("/") or not (root / "docs" / (guide[1:] + ".html")).is_file():
                raise ValueError(f"{identity}: missing local guide {guide}")
        for name, caption in journey.get("screenshots", {}).items():
            if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name) or not isinstance(caption, str) or not caption:
                raise ValueError(f"{identity}: invalid screenshot caption for {name!r}")
            if name in captions:
                raise ValueError(f"{identity}: screenshot {name} is already captioned")
            captions[name] = caption
    return captions


def load_journeys(root, manifest=None):
    journeys = json.loads((root / "docs/journeys.json").read_text())
    check_inventory(root, journeys)
    if manifest is not None:
        # the CI journeys are not the pinned Swift tests: the manifest's results stand in for upstream/
        return journeys, {test["name"]: test for test in manifest["tests"]}
    source = (root / "upstream" / TEST_PATH).read_text()
    matches = list(re.finditer(r"^    func (test\d+\w+)\(", source, re.M))
    cases = {}
    for index, match in enumerate(matches):
        name = match.group(1)
        end = matches[index + 1].start() if index + 1 < len(matches) else len(source)
        cases[name] = (source.count("\n", 0, match.start()) + 1, source[match.start():end])
    seen = set()
    for journey in journeys:
        identity = journey["id"]
        for test in journey["tests"]:
            if test not in cases:
                raise ValueError(f"{identity}: missing app test {test}")
            seen.add(test)
        if image := journey.get("image"):
            if not re.fullmatch(r"[a-z0-9-]+", image):
                raise ValueError(f"{identity}: invalid screenshot name")
            if not (root / f"docs/screenshots/{image}.png").is_file():
                raise ValueError(f"{identity}: missing screenshot {image}")
            if not any(f'"{image}", testCase: self' in cases[test][1] for test in journey["tests"]):
                raise ValueError(f"{identity}: screenshot was not captured by its app tests")
    if unowned := set(cases) - seen:
        raise ValueError("app tests need a documented journey: " + ", ".join(sorted(unowned)))
    captured = set()
    for swift in sorted((root / "upstream/UITests").glob("*.swift")):
        captured.update(re.findall(r'Screenshots\.capture\(app, "([a-z0-9-]+)", testCase: self\)',
                                   swift.read_text()))
    listed = {name for _, shots in ACTS for name, _ in shots}
    if unproven := listed - captured:
        raise ValueError("checkpoint is not captured by the journey: " + ", ".join(sorted(unproven)))
    for name in sorted(listed):
        if not (root / f"docs/screenshots/{name}.png").is_file():
            raise ValueError(f"missing checkpoint screenshot: {name}.png")
    video = root / "docs" / VIDEO_PATH
    if not video.is_file():
        raise ValueError(f"missing journey video: {VIDEO_PATH}")
    if unresolved(video):
        raise ValueError("journey video is an unresolved LFS pointer")
    return journeys, cases

def escape(value):
    return html.escape(value, quote=True)


def words(identifier):
    """A caption for a name nothing captions: 13b-multisig-transactions is "Multisig transactions"."""
    text = re.sub(r"^\d+[a-z]?-", "", identifier).replace("-", " ").strip()
    return (text[:1].upper() + text[1:]) or identifier


def test_words(name):
    text = re.sub(r"(?<!^)(?=[A-Z])", " ", re.sub(r"^test\d*", "", name)).lower().strip()
    return (text[:1].upper() + text[1:]) or name


def reference_acts():
    return [(heading, [(name, caption, SHOT_WIDTH, SHOT_HEIGHT) for name, caption in shots])
            for heading, shots in ACTS]


def ci_acts(manifest, captions):
    """The manifest's screenshots in order, grouped by the test that captured them."""
    acts = {}
    for shot in manifest["screenshots"]:
        test = shot.get("test")
        heading = TEST_HEADINGS.get(test) or (test_words(test) if test else "More screens")
        acts.setdefault(heading, []).append(
            (shot["name"], captions.get(shot["name"]) or words(shot["name"]), shot["width"], shot["height"]))
    return list(acts.items())


def recorded_run(acts):
    """Keep every proven capture available without making it the landing page."""
    rendered = []
    for heading, shots in acts:
        frames = "".join(
            f'<li><figure><a href="screenshots/{name}.png">'
            f'<img src="screenshots/{name}.png" width="{width}" height="{height}" '
            f'loading="lazy" decoding="async" alt="Winnow on iPhone: {escape(caption.lower())}."></a>'
            f'<figcaption>{escape(caption)}</figcaption></figure></li>'
            for name, caption, width, height in shots)
        rendered.append(f'<h3>{escape(heading)}</h3>\n<ol class="filmstrip">{frames}</ol>')
    acts, total = rendered, sum(len(shots) for _, shots in acts)
    return f'''<details class="screen-gallery" id="screens">
<summary><span>Explore all {total} screens</span><span class="disclosure-mark" aria-hidden="true">+</span></summary>
<div class="gallery-content">{"".join(acts)}</div></details>'''


REFERENCE_MODES = [
    ("everyday", "Everyday", "You approve", "56-home-beginner", "Your everyday wallet", "One key. One decision.", "Receive, review, send. All from your phone.", "1 key · 1 signature", 1, 1),
    ("both", "Both keys", "2 of 2", "40-extra-device-confirmed", "Two keys, both required", "Two keys. Both sign.", "Your phone and a Ledger both approve each payment.", "2-of-2 · 2 signatures", 2, 2),
    ("shared", "Any two", "2 of 3", "28-savings-confirmed", "Any two of three", "Two approve. One can be away.", "Any two of three signers can approve a payment. Add a recovery path that opens after a delay.", "2-of-3 · 2 signatures", 3, 2),
]
FIELDS = ("key", "name", "rule", "shot", "caption", "heading", "description", "technical", "keys", "needed")


def reference_media():
    """What the homepage says about the committed reference recording."""
    return {"modes": [dict(zip(FIELDS, mode), width=SHOT_WIDTH, height=SHOT_HEIGHT) for mode in REFERENCE_MODES],
            "acts": reference_acts(), "poster": "56-home-beginner", "network": "SIGNET",
            "path_label": "Recorded with the earlier Swift app: an ordinary send, a two-key send, then a 2-of-3 send",
            "note": "Real payments on private signet, recorded with the earlier Swift app.",
            "video_label": "Ordinary, two-key and 2-of-3 payments in the earlier Swift app",
            "dialog_note": "Private signet · earlier Swift app", "run": None}


def ci_media(manifest, captions):
    """What the homepage says about a CI run's media: its screenshots, sizes and network."""
    sizes = {shot["name"]: (shot["width"], shot["height"]) for shot in manifest["screenshots"]}
    modes = []
    for mode in REFERENCE_MODES:
        mode = dict(zip(FIELDS, mode), width=SHOT_WIDTH, height=SHOT_HEIGHT)
        candidates, words_for_ci = CI_MODES[mode["key"]]
        shot = next((name for name in candidates if name in sizes), None)
        if shot is None:
            print(f"homepage: no CI screenshot for {mode['key']} ({', '.join(candidates)}); "
                  f"keeping {mode['shot']}", file=sys.stderr)
        else:
            mode.update(words_for_ci, shot=shot, width=sizes[shot][0], height=sizes[shot][1])
        modes.append(mode)
    network = str(manifest.get("network") or "regtest")
    return {"modes": modes, "acts": ci_acts(manifest, captions), "poster": modes[0]["shot"],
            "network": network.upper(),
            "path_label": "Three of the recorded journeys: an ordinary send, a 2-of-2 payment with a Ledger, "
                          "and a 2-of-3 payment with its recovery path",
            "note": f"Real payments on a private {network} node, recorded by CI. The 2-of-3’s other signers are "
                    "Bitcoin Core wallets on that node; the Ledger is simulated.",
            "video_label": "Winnow’s recorded UI journeys, one after another: ordinary, 2-of-3, Ledger, fee-bump "
                           "and silent payments among them",
            "dialog_note": f"Private {network} · recorded by CI", "run": manifest}


LEAN = "https://github.com/winnowwallet/winnow-lean"
LEANNATIVE = "https://leannative.com"
# What every CI run checks before it records the journeys (winnow-lean's ci.yml, LeanNative's ios-app workflow).
GATES = [
    "Lean built from source, every proof checked",
    "Wallet, network and multisig tests against Bitcoin Core on a private regtest node",
    "Simulator and device builds, each checked to contain no Swift",
    "Release builds checked to carry no test mode",
    "The app driven through these journeys on screen, and recorded",
]


def duration(seconds):
    """A test's time in minutes and seconds, as a person says it."""
    minutes, rest = divmod(round(seconds), 60)
    return f"{minutes} min {rest} s" if minutes else f"{rest} s"


def screens(n):
    return f"{n} screen" if n == 1 else f"{n} screens"


def checked_section(run):
    """The newest passing CI run of the app: what it ran, on what, from which commit. None: no section."""
    if not run:
        return ""
    counts = {}
    for shot in run["screenshots"]:
        counts[shot.get("test")] = counts.get(shot.get("test"), 0) + 1
    rows = "".join(
        f'<li><span class="test-name">{escape(TEST_HEADINGS.get(test["name"]) or test_words(test["name"]))}'
        f'<code>{escape(test["name"])}</code></span><span class="test-shots">{screens(counts.get(test["name"], 0))}</span>'
        f'<span class="test-time">{duration(test["seconds"])}</span>'
        f'<span class="test-result">{escape(test["result"])}</span></li>'
        for test in run["tests"])
    device = run.get("device") or {}
    on = " · ".join(escape(str(part)) for part in (device.get("name"), device.get("os")) if part)
    when = escape(str(run.get("normalized_at") or "")[:10])
    sha = escape(run["source_sha"])
    run_link = (f'<a href="{escape(run["run_url"])}">CI run ↗</a>' if run.get("run_url") else "a local run")
    gates = "".join(f"<li>{escape(gate)}</li>" for gate in GATES)
    return f'''<section class="checked" id="checked" aria-labelledby="checked-title">
<div class="section-heading"><p class="eyebrow">CHECKED ON EVERY COMMIT</p><h2 id="checked-title">Every change runs the app.</h2></div>
<div class="checked-grid"><div class="checked-copy"><p>Each change to Winnow builds the app from its Lean source, runs it in a simulator against a private Bitcoin node, and records what happened. The screens above come from the newest run that passed.</p>
<dl class="run-facts"><div><dt>Commit</dt><dd><a href="{escape(commit_url(run))}"><code>{sha[:7]}</code></a></dd></div><div><dt>Device</dt><dd>{on or "Simulator"}</dd></div><div><dt>Network</dt><dd>{escape(str(run.get("network") or "regtest"))}</dd></div><div><dt>Recorded</dt><dd>{when}</dd></div><div><dt>Source</dt><dd>{run_link}</dd></div></dl>
<ul class="gates">{gates}</ul>
<p class="gate-note">A release tag goes to TestFlight only when a full run like this has already passed on the same tree. The release finds that run; it does not test again.</p></div>
<ol class="test-list" aria-label="UI journeys in this run">{rows}</ol></div>
</section>'''


def lean_section():
    return f'''<section class="lean" id="lean" aria-labelledby="lean-title">
<div class="section-heading"><p class="eyebrow">WRITTEN IN LEAN 4</p><h2 id="lean-title">No Swift. One language, top to bottom.</h2></div>
<div class="lean-grid">
<article><p class="lean-label">01 · The wallet</p><h3>Bitcoin in Lean</h3><p>Keys, transactions, PSBTs, descriptors, compact-filter sync, peers and broadcast are Lean 4 compiled to C. Every key and signature runs on one secp256k1, proved in Lean against the curve as specified.</p></article>
<article><p class="lean-label">02 · The app</p><h3>Model, update, view</h3><p>Each screen is a Lean function from the wallet’s state. Standard iOS controls draw it, through an Objective-C shell that is itself printed from Lean at build time.</p></article>
<article><p class="lean-label">03 · The framework</p><h3>LeanNative</h3><p>Keychain, Face ID, Bluetooth, iCloud and background tasks reach Lean as typed capabilities. The Xcode project is generated from a Lean description of the app, which refuses a permission without its explanation.</p></article>
</div>
<p class="lean-links"><a href="{LEAN}">Source on GitHub ↗</a><a href="/architecture">How it works</a><a href="{LEAN}/blob/main/PORT.md">How the port was checked ↗</a><a href="{LEANNATIVE}">LeanNative ↗</a></p>
</section>'''


def homepage(journeys, cases, media=None):
    media = media or reference_media()
    title = "Winnow — Bitcoin, on your terms"
    intro = "A Bitcoin wallet for iPhone and iPad. Pay from your phone, add a Ledger as a second key, or share a wallet with a way back after a delay."
    choices, policies, screens = [], [], []
    for index, mode in enumerate(media["modes"]):
        key, name, rule, shot, caption, heading, description, technical, keys, needed = (mode[field] for field in FIELDS)
        choices.append(f'''<label class="mode-choice"><input type="radio" name="wallet-mode" id="mode-{key}" value="{key}" aria-controls="policy-{key} screen-{key}"{' checked' if index == 0 else ''}>
<span><b>{name}</b><small>{rule}</small></span></label>''')
        dots = ''.join(f'<i class="key-dot{" absent" if n >= needed else ""}">{"✓" if n < needed else "–"}</i>' for n in range(keys))
        policies.append(f'''<div class="policy mode-{key}" id="policy-{key}">
<div class="policy-diagram" aria-hidden="true">{dots}<span class="policy-line"></span><span class="policy-result">{needed}/{keys}</span></div>
<h2>{heading}</h2><p>{description}</p><a class="technical" href="/vaults">{technical} <span aria-hidden="true">↗</span></a></div>''')
        screens.append(f'''<figure class="wallet-screen mode-{key}" id="screen-{key}">
<a href="screenshots/{shot}.png" aria-label="Enlarge {caption.lower()}"><img src="screenshots/{shot}.png" width="{mode['width']}" height="{mode['height']}" loading="{'eager' if index == 0 else 'lazy'}" {'fetchpriority="high"' if index == 0 else ''} decoding="async" alt="{caption} in the real Winnow app."></a>
<figcaption><span class="screen-number">0{index + 1} / 03</span>{caption}</figcaption></figure>''')
    return f'''<!doctype html>
<!-- Generated by scripts/build-site. -->
