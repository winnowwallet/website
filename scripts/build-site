def commit_url(evidence):
    """The tested commit, in the repository whose run produced the media."""
    run = re.match(r"(https://[^/]+/[^/]+/[^/]+)/actions/runs/", str(evidence.get("run_url") or ""))
    return f'{run.group(1) if run else WALLET}/commit/{evidence["source_sha"]}'


def ci_details(evidence):
    video, original = evidence["video"], evidence.get("original_video")
    run = (f'<a href="{escape(evidence["run_url"])}">this successful CI run</a>' if evidence.get("run_url")
           else "a local run (no CI run URL)")
    device = evidence.get("device") or {}
    simulator = ""
    if device.get("name"):
        simulator = f' on an {escape(str(device["name"]))} simulator'
        simulator += f' ({escape(str(device["os"]))})' if device.get("os") else ""
    tests = "".join(f'<li><code>{escape(test["name"])}</code>: {escape(test["result"])}, {test["seconds"]:.3f} seconds</li>'
                    for test in evidence["tests"])
    source = escape(evidence["source_sha"])
    branch = f' on <code>{escape(evidence["branch"])}</code>' if evidence.get("branch") else ""
    kept = (f' The untouched simulator recording was {original["width"]} × {original["height"]}, '
            f'{original["duration_seconds"]:.3f} seconds, {original["bytes"]:,} bytes.' if isinstance(original, dict) else "")
    return f'''<p>This recording and its {len(evidence["screenshots"])} checkpoint screenshots come from {run} of the wallet’s UI journeys{simulator}, paying on a private {escape(str(evidence.get("network") or "regtest"))} node.</p>
<p>Source: <a href="{escape(commit_url(evidence))}"><code>{source}</code></a>{branch}. Every test passed, {evidence["test_seconds"]:.3f} seconds in all:</p>
<ul>{tests}</ul>
<p>The browser copy is H.264, {video["width"]} × {video["height"]}, {video["duration_seconds"]:.3f} seconds, {video["bytes"]:,} bytes.{kept}</p>
<p><a href="/journey-provenance.json">Media checksums and the run’s details</a>. The tests’ assertions establish success; the video illustrates the flow.</p>
<p>The site takes these media from the wallet’s newest successful run on each build. Other guide illustrations retain their <a href="{SOURCE}docs/screenshots/README.md">historical provenance</a>.</p>'''


def recording_page(root, evidence_v2=None):
    manifest = root / "docs/journey-provenance.json"
    poster, label = "56-home-beginner", "Ordinary and multisig payments in Winnow"
    if evidence_v2 is not None:
        details = ci_details(evidence_v2)
        poster, label = evidence_v2.get("poster", poster), "The wallet’s UI journeys in Winnow"
    elif manifest.exists():
        evidence = json.loads(manifest.read_text())
        source = escape(evidence["source_sha"])
        video = evidence["video"]
        details = f'''<p>This recording and its {len(evidence["screenshots"])} checkpoint screenshots come from <a href="{escape(evidence["run_url"])}">this successful CI run</a>.</p>
<p>Test: <code>{escape(evidence["test"])}</code>, {evidence["test_seconds"]:.3f} seconds. Source: <a href="{SOURCE.replace('/blob/main/', '/commit/')}{source}"><code>{source}</code></a>.</p>
<p>The full host recording is retained without cuts or speed changes. The browser copy is H.264, {video["width"]} × {video["height"]}, {video["duration_seconds"]:.3f} seconds, {video["bytes"]:,} bytes.</p>
<p><a href="/journey-provenance.json">Media checksums and original recording details</a>. The run’s app artifact contains the original recording, log, and result bundle. Those assertions establish success; the video illustrates the flow.</p>
<p>A website-only build can reuse this recording. Its source and run above remain the ones that produced the media. Other guide illustrations retain their <a href="{SOURCE}docs/screenshots/README.md">historical provenance</a>.</p>'''
    else:
        details = f'''<p>This is the reviewed repository reference recording, retained when a build has no fresh or cached journey media. It does not claim a new integration run.</p>
<p>Read its <a href="{SOURCE}docs/videos/README.md">recording provenance</a> and <a href="{SOURCE}docs/screenshots/README.md">screenshot provenance</a> for the tested source, date, and result.</p>'''
    return f'''<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Wallet journey — Winnow</title><link rel="stylesheet" href="/site.css">
<style>video{{display:block;width:min(100%,26rem);max-height:75vh;margin:1.5rem auto;border:1px solid var(--rule);border-radius:1rem;background:#111}}</style></head>
<body><a class="skip-link" href="#main">Skip to content</a>
<header class="topbar"><div class="bar"><a class="mark" href="/" aria-label="Winnow home">winnow</a><nav class="links" aria-label="Main"><a href="/blog/">Blog</a><a href="/research/">Research</a><a href="/architecture">How it works</a><a href="/vaults">Multisig</a><a href="https://github.com/winnowwallet/winnow-lean">GitHub ↗</a></nav></div></header><main id="main"><p class="page-kicker">Recorded in the real app</p><h1>Wallet journey</h1>
<video controls playsinline preload="metadata" poster="/screenshots/{poster}.png" aria-label="{escape(label)}">
<source src="/{VIDEO_PATH}" type="video/mp4">
<a href="/{VIDEO_PATH}">Download the wallet journey recording</a>.
</video>
<h2>Recording provenance</h2>{details}<p><a href="/archive">Historical recordings and notes</a></p></main><footer><div class="bar"><nav aria-label="Footer"><a href="/roadmap">Roadmap</a><a href="/privacy">Privacy</a><a href="/recording">Recording</a></nav></div></footer></body></html>
'''

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="fail if generated pages are stale")
    parser.add_argument("--root", type=Path, default=ROOT, help="repository or staging root")
    args = parser.parse_args()
    manifest = load_manifest(args.root)
    journeys, cases = load_journeys(args.root, manifest)
    if manifest is None:
        media = reference_media()
        pages = {"index.html": homepage(journeys, cases, media), "recording.html": recording_page(args.root)}
    else:
        media = ci_media(manifest, check_inventory(args.root, journeys))
        pages = {"index.html": homepage(journeys, cases, media),
                 "recording.html": recording_page(args.root, dict(manifest, poster=media["poster"]))}
    for name, rendered in pages.items():
        output = args.root / "docs" / name
        if args.check:
            if not output.exists() or output.read_text() != rendered:
                raise SystemExit(f"{name} is stale; run scripts/build-site")
        else:
            output.write_text(rendered)
    source = (f"CI journey media from {manifest.get('run_url') or 'a local run'}" if manifest
              else "the committed reference media")
    print(f"Documented features: {len(journeys)}; UI test scenarios: {len(cases)}; {source}")

if __name__ == "__main__":
    main()
